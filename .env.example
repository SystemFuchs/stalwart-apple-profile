# --- Required ---------------------------------------------------------------
# Public URL of this service (the redirect URI is PUBLIC_URL/callback)
PUBLIC_URL=https://profile.example.org
# Base URL of your Stalwart server
STALWART_URL=https://mail.example.org
# Key for the signed state cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me

# --- OAuth ------------------------------------------------------------------
CLIENT_ID=apple-profile
# Only if the OAuth client in Stalwart has a secret; empty = public client with PKCE
CLIENT_SECRET=
# Requested scopes (space-separated). Stalwart >= 1.1 needs "full" to create an app password
# that inherits the user's rights; the OAuthClient must allow every scope listed here.
OAUTH_SCOPE=urn:ietf:params:oauth:scope:mail urn:ietf:params:oauth:scope:calendars urn:ietf:params:oauth:scope:contacts urn:stalwart:oauth:scope:full
# Revoke the OAuth token right after the app password has been created
REVOKE_TOKEN=1

# --- Servers written into the profile ----------------------------------------
# Default for MAIL_HOST: host of STALWART_URL. Default for DAV_HOST: MAIL_HOST.
#MAIL_HOST=mail.example.org
IMAP_PORT=993
IMAP_SSL=1
SMTP_PORT=465
SMTP_SSL=1
#DAV_HOST=mail.example.org
DAV_PORT=443
# 1 = set CalDAVPrincipalURL/CardDAVPrincipalURL (/dav/cal/<user>/, /dav/card/<user>/).
# 0 = let the device discover them via /.well-known (works with Stalwart).
DAV_SET_PRINCIPAL_URL=0

# --- Profile and pages --------------------------------------------------------
# Organisation shown in the profile (empty = omitted)
PROFILE_ORG=
# Reverse-DNS prefix of the profile identifiers (default: reversed host of PUBLIC_URL)
#PROFILE_ID_PREFIX=org.example.profile
# Page language: auto (Accept-Language), en or de
UI_LANG=auto
# Custom page title (empty = built-in title in the user's language)
#PAGE_TITLE=
# Where users delete old app passwords (default: STALWART_URL/account)
#SELF_SERVICE_URL=https://mail.example.org/account

# --- App password ---------------------------------------------------------------
# Expiry in days (0 = no expiry)
APP_PASSWORD_EXPIRY_DAYS=0
# Permissions removed from each generated app password (comma-separated, empty = inherit all)
APP_PASSWORD_DISABLE=sysAppPasswordCreate,sysAppPasswordUpdate,sysAppPasswordDestroy,sysApiKeyCreate,sysApiKeyUpdate,sysApiKeyDestroy,sysAccountPasswordUpdate,pop3Authenticate

# --- Network --------------------------------------------------------------------
# Number of reverse proxies in front of the service (0 = none, use the socket address)
TRUSTED_PROXIES=1
# Per-IP rate limit for /start and /callback (0 disables)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=300

LOG_LEVEL=INFO
